<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>CamControl</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CamControl a besoin d'accéder à votre réseau local pour trouver et contrôler vos caméras WiFi.</string>
	<key>NSCameraUsageDescription</key>
	<string>CamControl utilise l'appareil photo pour scanner des QR codes de configuration de caméra (optionnel).</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>CamControl peut enregistrer des instantanés de vos caméras dans votre photothèque.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_onvif._tcp</string>
		<string>_rtsp._tcp</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
